rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'admin-panel-user';
    }

    // Kullanıcı profili ve alt koleksiyonları (adresler, siparişler, favoriler) - sadece kendi verisi
    match /users/{uid} {
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      match /addresses/{addressId} {
        allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      }
      match /orders/{orderId} {
        allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      }
      match /favorites/{productId} {
        allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      }
    }

    // Misafir siparişleri
    match /guestOrders/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Kupon kodları — herkes okuyabilir, yazma admin
    match /coupons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // İletişim formu mesajları
    match /contactMessages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // GES teklif talepleri
    match /gesQuotes/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // GES teklif doğrulama talepleri
    match /gesVerifications/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Bülten abonelikleri
    match /newsletter/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Katalog ürünleri (admin tarafından yönetilen)
    match /catalog/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Stok overrides (admin tarafından yönetilen)
    match /stockOverrides/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
